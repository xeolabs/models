{
  "name": "@xeokit/models",
  "version": "1.0.0",
  "description": "Local model catalog for glTF, IFC and AECO exchange formats",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./browser": {
      "types": "./build/browser/index.d.ts",
      "import": "./build/browser/index.js"
    }
  },
  "bin": {
    "models": "build/cli.js"
  },
  "files": [
    "build",
    "docs",
    "README.md",
    "vendor/xeokit"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config app/vite.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p app/tsconfig.json",
    "lint": "eslint src app tests && node tools/format.mjs --check",
    "test": "npm run build && vitest run",
    "prepack": "npm run build",
    "format": "node tools/format.mjs --write",
    "dev": "vite --config app/vite.config.ts",
    "app": "node build/cli.js serve",
    "test:package": "node tools/package-smoke.mjs",
    "vendor:sdk": "node tools/vendor-xeokit.mjs && node tools/vendor-preview.mjs",
    "vendor:preview": "node tools/vendor-preview.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@types/pg": "^8.23.1",
    "commander": "^13.1.0",
    "dockview-vue": "8.3.1",
    "element-plus": "2.8.8",
    "lucide-vue-next": "0.468.0",
    "pg": "^8.23.1",
    "pinia": "2.3.1",
    "sharp": "0.35.5",
    "stream-json": "3.9.0",
    "vue": "3.5.13",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vue/test-utils": "2.4.6",
    "@webgpu/types": "^0.1.64",
    "esbuild": "0.28.2",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
